# TokenZip Protocol (TZP) - TrexAPI 占位镜像
# 用于在 Docker Hub 抢占 tokenzip/trexapi 仓库名
FROM node:20-alpine
LABEL maintainer="TokenZip Labs"
LABEL description="TZP TrexAPI edge gateway - placeholder. See https://github.com/tokenzip/trex-api"
RUN echo "trexapi placeholder - see https://github.com/tokenzip/trex-api" && node -v
CMD ["node", "-e", "console.log('trexapi 0.0.1 - TZP placeholder. https://github.com/tokenzip/trex-api')"]
